# Copy this file to ".env" and fill it in. NEVER commit ".env".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=UH_GCR_Inventory
DB_USER=svc_gcr_inventory
DB_PASSWORD=CHANGE-ME

# Web server. 0.0.0.0 = reachable from devices on the UH campus network (UH guest Wi-Fi). 
# Use 127.0.0.1 to allow only this PC
HOST=0.0.0.0
PORT=3000

# Low-stock alert emails (leave SMTP_HOST blank to keep alerts queued without sending)
# UH Outlook: smtp.office365.com, port 587, SMTP_SECURE=false
# Gmail:      smtp.gmail.com, port 465, SMTP_SECURE=true, password = Gmail app password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM="GCR Inventory Alerts <inventory@example.edu>"
ALERT_POLL_SECONDS=60
